source "https://rubygems.org"

# Mirrors the exact Jekyll + plugin versions GitHub Pages builds with,
# so a local preview matches production. GitHub Pages ignores this file
# and builds the site natively — it exists only for `bundle exec jekyll serve`.
gem "github-pages", group: :jekyll_plugins

# Stdlib gems unbundled from Ruby 3.4, needed by Jekyll 3.x locally.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "webrick"
